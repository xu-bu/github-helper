{
  "manifest_version": 3,
  "name": "GitHub Helper",
  "version": "1.1",
  "description": "Copy button next to file names in GitHub review comments, plus a new-comment alert.",
  "permissions": ["notifications", "storage"],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "host_permissions": ["https://api.github.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js", "comment-alert.js", "go-to-conversation.js"],
      "run_at": "document_idle"
    }
  ]
}
